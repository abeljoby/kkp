---
import '../styles/global.css';

const title = 'KKP Group | Engineering, Construction & Property Services';
const description = 'Find the KKP Group business for your next build, interior, property-care requirement or workspace in the UAE. Explore our expertise and contact a specialist.';

---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a2349" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

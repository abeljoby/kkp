---
import Layout from '../layouts/Layout.astro';
import LegacyHome from '../components/LegacyHome.astro';
import { companies, values } from '../data/group';

const designs = [
  { id: 'signature', name: 'Signature', detail: 'Royal blue · gold · panoramic photography', color: '#123d8d' },
  { id: 'corporate', name: 'Corporate', detail: 'White · navy · an open, balanced layout', color: '#f1f3f6' },
  { id: 'precision', name: 'Precision', detail: 'Ink blue · gold · a structured company index', color: '#101d33' },
];
const earlier = [
  { id: 'modern', name: 'Modern', detail: 'Original green architectural concept', color: '#c6ed59' },
  { id: 'heritage', name: 'Heritage', detail: 'Original classic corporate concept', color: '#c7a46b' },
  { id: 'editorial', name: 'Editorial', detail: 'Original bold editorial concept', color: '#f05a3f' },
];
const scenes = [
  { image: 'hbanner03.jpg', alt: 'Commercial building from the Beamco image archive', label: 'Commercial environments' },
  { image: 'hbanner01.jpg', alt: 'Rooftop building services with the Dubai skyline beyond', label: 'Engineering & building services' },
  { image: 'hbanner04.jpg', alt: 'Detailed exterior of a residential property from the Beamco archive', label: 'Residential environments' },
];
---

<Layout>
  <div class="site-shell new-shell" data-design="signature">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="utility-bar"><div class="wrap utility-inner"><span>Dubai, United Arab Emirates</span><div class="utility-links"><a href="tel:+97144226185">+971 4 422 6185</a><a href="mailto:beamco@beamcointl.com">beamco@beamcointl.com</a></div></div></div>
    <header class="site-header" id="top"><div class="wrap header-inner">
      <a class="brand" href="#top" aria-label="KKP Group home"><img class="brand-logo" src="/images/brand/kkp-group-logo.png" width="76" height="76" alt="KKP Group" /><span class="brand-wordmark" aria-hidden="true">KKP GROUP<small>Since 1980</small></span></a>
      <nav class="main-nav" id="main-navigation" aria-label="Main navigation"><a href="#about">Our story</a><a href="#companies">Our companies</a><a href="#projects">Our work</a><a href="#contact">Contact</a></nav>
      <a class="header-cta" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="main-navigation"><span></span><span></span></button>
    </div></header>
    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-media">
          {scenes.map((scene, index) => <img class:list={['hero-photo', { 'is-active': index === 0 }]} src={`/images/beamco/webimg/${scene.image}`} alt={scene.alt} width="1920" height="700" fetchpriority={index === 0 ? 'high' : 'auto'} loading={index === 0 ? 'eager' : 'lazy'} aria-hidden={index !== 0 ? 'true' : undefined} />)}
        </div>
        <div class="wrap hero-content">
          <h1 id="hero-title">Engineering, <br />construction and <br /><span>property services.</span></h1>
          <p class="hero-copy">We provide specialist engineering, construction, interior, facilities management and business services across the UAE.</p>
          <div class="hero-actions"><a class="button button-primary" href="#companies">Our companies <span aria-hidden="true">↗</span></a><a class="text-link" href="#about">Our history <span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="hero-bottom wrap"><span class="hero-location" aria-live="polite">{scenes[0].label}</span><div class="scene-controls" role="group" aria-label="Choose a photograph">{scenes.map((scene, index) => <button type="button" class="scene-choice" data-scene={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-label={`Show ${scene.label.toLowerCase()}`}><span>0{index + 1}</span><i aria-hidden="true"></i></button>)}</div></div>
      </section>
      <section class="proof-strip" aria-label="Group highlights"><div class="wrap proof-inner"><p class="proof-label">KKP Group<span>Formerly Beamco Group</span></p><div class="proof-item"><strong>1980</strong><span>Established in Dubai</span></div><div class="proof-item"><strong>06</strong><span>Specialist companies</span></div><div class="proof-item"><strong>UAE</strong><span>Serving the UAE market</span></div><a class="proof-link" href="#about" aria-label="Learn about our history">↓</a></div></section>

      <section class="companies-section section" id="companies"><div class="wrap">
        <div class="section-heading"><h2>Our companies <br /><span>and capabilities.</span></h2><p>We bring together MEP contracting, construction, joinery, interior fit-out, facilities management and business-centre services.</p></div>
        <div class="company-grid">{companies.map((company) => <a class="company-card" href={`mailto:beamco@beamcointl.com?subject=${encodeURIComponent(`Enquiry: ${company.name}`)}`} aria-label={`Enquire about ${company.name}`}>
          <div class="company-image"><img class="company-cover" src={company.image} alt="" width="1920" height="552" loading="lazy" /></div>
          <span class="company-number">{company.number}</span><div class="company-info"><h3>{company.name}</h3><p>{company.type}</p></div><span class="company-arrow" aria-hidden="true">↗</span>
        </a>)}</div>
        <p class="content-note">Company names, service descriptions and contact details remain subject to client confirmation.</p>
      </div></section>

      <section class="story-section section" id="about"><div class="wrap story-layout">
        <div class="story-main"><h2>Our roots are in Dubai’s <br />construction sector.</h2><div class="story-copy"><p>We began in 1980 as Beamco Group, working in the UAE construction and maintenance sector. Over time, we have added specialist businesses that support the planning, delivery and operation of properties.</p><p>Today, our companies work across MEP engineering, construction, interior fit-out, joinery, facilities services and business space—each with a clear area of responsibility.</p></div><a class="text-link" href="https://beamcointl.com/chairman.php" target="_blank" rel="noreferrer">Read our chairman’s message <span aria-hidden="true">↗</span></a></div>
        <figure class="story-image"><img src="/images/beamco/webimg/chairman.jpg" alt="K. K. Peethambaran, Chairman and Managing Director, at his office" width="767" height="511" loading="lazy" /><figcaption><strong>K. K. Peethambaran</strong><span>Chairman &amp; Managing Director</span></figcaption></figure>
        <div class="story-date"><span>Since</span><strong>1980</strong><span>Dubai, United Arab Emirates</span></div>
      </div></section>

      <section class="values-section section"><div class="wrap values-layout"><div class="section-heading values-title"><h2>How we work <br /><span>with clients.</span></h2><p>We combine specialist knowledge with the coordination needed for complex projects and occupied properties.</p></div><div class="values-list">{values.map((value) => <article class="value-row"><span class="value-number">{value.n}</span><div><h3>{value.title}</h3><p>{value.text}</p></div></article>)}</div></div></section>

      <section class="project-section" id="projects"><div class="wrap project-layout"><div class="project-content"><h2>Services for projects <br />and properties.</h2><p>We support commercial, residential, hospitality and institutional environments with complementary services from construction delivery through to ongoing operations.</p><a class="button button-light" href="#contact">Discuss your requirements <span aria-hidden="true">↗</span></a></div><div class="project-visual"><figure><img class="project-photo" src="/images/beamco/webimg/projects-list-beamelectro01.jpg" alt="Mechanical engineering installation from the Beam Electro-Mechanical project archive" width="360" height="276" loading="lazy" /><figcaption>Beam Electro-Mechanical · Project archive</figcaption></figure><ul class="sector-list" aria-label="Environments we support"><li>Commercial</li><li>Residential</li><li>Hospitality</li><li>Institutional</li></ul></div></div></section>

      <section class="contact-section section" id="contact"><div class="wrap contact-layout"><div><h2>Contact us.</h2><p>For business enquiries, project requirements or an introduction to the relevant company, contact our Dubai office.</p></div><div class="contact-details"><a class="contact-email" href="mailto:beamco@beamcointl.com">beamco@beamcointl.com <span aria-hidden="true">↗</span></a><div class="contact-meta"><div><span>Call us</span><a href="tel:+97144226185">+971 4 422 6185</a></div><div><span>Office</span><p>XL Tower, Business Bay <br />Dubai, United Arab Emirates</p></div></div></div></div></section>
    </main>
    <footer class="site-footer"><div class="wrap footer-main"><a class="brand" href="#top" aria-label="KKP Group home"><img class="brand-logo" src="/images/brand/kkp-group-logo.png" width="76" height="76" loading="lazy" alt="KKP Group" /><span class="brand-wordmark" aria-hidden="true">KKP GROUP<small>Since 1980</small></span></a><p>Engineering, construction <br />and property services.</p><div class="footer-links"><a href="#about">Our history</a><a href="#companies">Our companies</a><a href="#projects">Our work</a><a href="#contact">Contact us</a></div></div><div class="wrap footer-bottom"><span>© 2026 KKP Group · Prototype concept</span><span>Formerly Beamco Group · Details subject to client confirmation</span></div></footer>
  </div>
  <LegacyHome />

  <aside class="design-switcher" aria-label="Prototype design options">
    <button class="switcher-trigger" type="button" aria-expanded="false" aria-controls="switcher-panel"><span class="switcher-icon" aria-hidden="true">◧</span><span>Explore designs <b class="current-design">01 / Signature</b></span><span class="switcher-chevron" aria-hidden="true">⌃</span></button>
    <div class="switcher-panel" id="switcher-panel" hidden><div class="switcher-heading"><p>Choose a direction</p><button class="switcher-close" aria-label="Close design options" type="button">×</button></div>
      <p class="switcher-group-label">New concepts</p><div class="design-options" role="group" aria-label="New concepts">{designs.map((design, index) => <button class="design-option" type="button" data-choice={design.id} data-label={`0${index+1} / ${design.name}`} aria-pressed={index === 0 ? 'true' : 'false'}><span class="option-swatch" style={`--swatch: ${design.color}`}></span><span><b>0{index+1} — {design.name}</b><small>{design.detail}</small></span><span class="option-check" aria-hidden="true">✓</span></button>)}</div>
      <p class="switcher-group-label">Earlier concepts · reference</p><div class="design-options" role="group" aria-label="Earlier concepts">{earlier.map((design, index) => <button class="design-option" type="button" data-choice={design.id} data-label={`0${index+4} / ${design.name}`} aria-pressed="false"><span class="option-swatch" style={`--swatch: ${design.color}`}></span><span><b>0{index+4} — {design.name}</b><small>{design.detail}</small></span><span class="option-check" aria-hidden="true">✓</span></button>)}</div>
      <p class="switcher-hint">Design review only. All six concepts remain available.</p>
    </div>
    <span class="sr-only design-status" role="status"></span>
  </aside>

  <script>
    const shell = document.querySelector<HTMLElement>('.new-shell');
    const legacy = document.querySelector<HTMLElement>('.legacy-shell');
    const trigger = document.querySelector<HTMLButtonElement>('.switcher-trigger');
    const panel = document.querySelector<HTMLElement>('.switcher-panel');
    const choices = [...document.querySelectorAll<HTMLButtonElement>('.design-option')];
    const allowed = ['signature', 'corporate', 'precision', 'modern', 'heritage', 'editorial'];
    const setDesign = (design: string, announce = false) => {
      if (!allowed.includes(design) || !shell || !legacy) return;
      const isLegacy = ['modern', 'heritage', 'editorial'].includes(design);
      shell.hidden = isLegacy;
      legacy.hidden = !isLegacy;
      (isLegacy ? legacy.querySelector('.site-shell') : shell)?.setAttribute('data-design', design);
      choices.forEach((choice) => choice.setAttribute('aria-pressed', String(choice.dataset.choice === design)));
      const label = choices.find((choice) => choice.dataset.choice === design)?.dataset.label ?? design;
      document.querySelector('.current-design')!.textContent = label;
      if (announce) document.querySelector('.design-status')!.textContent = `${label} design selected`;
      try { localStorage.setItem('kkp-design-v2', design); } catch { /* Review works without storage. */ }
    };
    try { setDesign(localStorage.getItem('kkp-design-v2') ?? 'signature'); } catch {}
    const togglePanel = (open: boolean, restoreFocus = false) => {
      trigger?.setAttribute('aria-expanded', String(open));
      if (panel) panel.hidden = !open;
      if (restoreFocus) trigger?.focus();
    };
    trigger?.addEventListener('click', () => togglePanel(trigger.getAttribute('aria-expanded') !== 'true'));
    document.querySelector('.switcher-close')?.addEventListener('click', () => togglePanel(false, true));
    choices.forEach((choice) => choice.addEventListener('click', () => {
      setDesign(choice.dataset.choice ?? 'signature', true);
      togglePanel(false, true);
      // A previous section hash may refer to the now-hidden reference concept.
      if (location.hash) history.replaceState(null, '', location.pathname + location.search);
      window.scrollTo({ top: 0, behavior: 'instant' });
    }));
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !document.querySelector('.design-switcher')?.contains(event.target)) togglePanel(false);
    });
    document.querySelectorAll<HTMLElement>('.site-header').forEach((header) => {
      const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = header.querySelector('.main-nav');
      const close = () => { nav?.classList.remove('is-open'); toggle?.setAttribute('aria-expanded', 'false'); toggle?.setAttribute('aria-label', 'Open navigation'); };
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        nav?.classList.toggle('is-open', open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); } });
    });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !panel?.hidden) togglePanel(false, true); });
    const photos = [...document.querySelectorAll<HTMLImageElement>('.hero-photo')];
    const scenes = [...document.querySelectorAll<HTMLButtonElement>('.scene-choice')];
    const labels = ['Commercial environments', 'Engineering & building services', 'Residential environments'];
    scenes.forEach((button, index) => button.addEventListener('click', () => {
      photos.forEach((photo, i) => { photo.classList.toggle('is-active', i === index); photo.setAttribute('aria-hidden', String(i !== index)); });
      scenes.forEach((scene, i) => scene.setAttribute('aria-pressed', String(i === index)));
      document.querySelector('.hero-location')!.textContent = labels[index];
    }));
  </script>
</Layout>

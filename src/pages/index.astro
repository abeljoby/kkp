---
import Layout from '../layouts/Layout.astro';

const companies = [
	{ number: '01', name: 'Beam Electro-Mechanical Contracting', type: 'MEP engineering, contracting & maintenance', initials: 'BE', image: '/images/beamco/webimg/innerbanner13.jpg' },
	{ number: '02', name: 'Beam Carpentry', type: 'Joinery, carpentry & bespoke woodwork', initials: 'BC', image: '/images/beamco/webimg/innerbanner04.jpg' },
	{ number: '03', name: 'FIS Interior Decoration', type: 'Interior fit-out & decoration', initials: 'FIS', image: '/images/beamco/webimg/innerbanner05.jpg' },
	{ number: '04', name: 'Superfine Services', type: 'Facilities management services', initials: 'SF', image: '/images/beamco/webimg/innerbanner08.jpg' },
	{ number: '05', name: 'Mint Business Center', type: 'Business centre & office solutions', initials: 'M', image: '/images/beamco/webimg/innerbanner07.jpg' },
	{ number: '06', name: 'Eminent Contracting', type: 'Civil construction & maintenance', initials: 'EC', image: '/images/beamco/webimg/innerbanner09.jpg' },
];

const values = [
	{ n: '01', title: 'Specialist expertise', text: 'Our companies focus on defined technical and operational disciplines, with practical knowledge of the UAE market.' },
	{ n: '02', title: 'Coordinated delivery', text: 'We bring complementary construction, fit-out, workplace and maintenance services together when a project requires them.' },
	{ n: '03', title: 'Operational continuity', text: 'Our capabilities extend from project delivery into the day-to-day support and upkeep of completed properties.' },
];
---

<Layout>
	<div class="site-shell" data-design="modern">
		<div class="utility-bar">
			<div class="wrap utility-inner">
				<span>Dubai, United Arab Emirates</span>
				<div class="utility-links"><a href="tel:+97144226185">+971 4 422 6185</a><span class="utility-divider"></span><a href="mailto:beamco@beamcointl.com">Email the group <span aria-hidden="true">↗</span></a></div>
			</div>
		</div>
		<header class="site-header wrap">
			<a class="brand" href="#top" aria-label="KKP Group home"><img class="brand-logo" src="/images/brand/kkp-group-logo.png" alt="KKP Group" /></a>
			<nav class="main-nav" aria-label="Main navigation">
				<a href="#about">Our story</a><a href="#companies">Our companies</a><a href="#projects">Our work</a><a href="#contact">Contact</a>
			</nav>
			<a class="header-cta" href="#companies">Explore the group <span aria-hidden="true">↗</span></a>
			<button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>
		</header>

		<main id="top">
			<section class="hero">
				<div class="hero-art" aria-hidden="true">
					<div class="art-grid"></div><div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
					<div class="art-building building-back"><i></i><i></i><i></i><i></i><i></i></div>
					<div class="art-building building-front"><i></i><i></i><i></i><i></i><i></i><i></i></div>
					<div class="art-sun"></div><div class="art-base"></div>
				</div>
				<div class="wrap hero-content">
					<h1>Engineering, construction<br />and property services<span class="hero-period">.</span></h1>
					<p class="hero-copy">We provide specialist engineering, construction, interior, facilities management and business services across the UAE. Our operating history began in Dubai in 1980 as Beamco Group.</p>
					<div class="hero-actions"><a class="button button-primary" href="#companies">Our companies <span aria-hidden="true">↗</span></a><a class="text-link" href="#about">Our history <span aria-hidden="true">↓</span></a></div>
				</div>
			</section>

			<section class="proof-strip" aria-label="Group highlights"><div class="wrap proof-inner"><span class="proof-label">KKP Group<br />formerly Beamco Group</span><div class="proof-item"><strong>1980</strong><span>Established in Dubai</span></div><div class="proof-item"><strong>06</strong><span>Specialist companies</span></div><div class="proof-item"><strong>UAE</strong><span>Serving the UAE market</span></div><a class="proof-link" href="#about" aria-label="Learn about our history">↘</a></div></section>

			<section class="section companies-section" id="companies">
				<div class="wrap">
					<div class="section-heading"><div><h2>Our companies<br />and capabilities.</h2></div><p class="section-intro">We bring together MEP contracting, construction, joinery, interior fit-out, facilities management and business-centre services.</p></div>
					<div class="company-grid">
						{companies.map((company) => <a class="company-card" href="#contact"><img class="company-cover" src={company.image} alt="" /><span class="company-top"><span class="company-number">{company.number}</span><span class="company-arrow" aria-hidden="true">↗</span></span><span class="company-monogram">{company.initials}</span><span class="company-name">{company.name}</span><span class="company-type">{company.type}</span></a>)}
					</div>
					<p class="content-note"><sup>1</sup> KKP Group is the successor identity to Beamco Group. Company names, service descriptions and contact details remain subject to client confirmation.</p>
				</div>
			</section>

			<section class="story-section" id="about">
				<div class="wrap story-layout"><div class="story-label"><span class="story-index">Since<br /><b>1980</b></span></div><div class="story-main"><h2>Our roots are in Dubai’s<br />construction sector.</h2><div class="story-copy"><p>We began in 1980 as Beamco Group, working in the UAE construction and maintenance sector. Over time, we have added specialist businesses that support the planning, delivery and operation of properties.</p><p>Today, our companies work across MEP engineering, construction, interior fit-out, joinery, facilities services and business space—each with a clear area of responsibility.</p><a class="text-link" href="https://beamcointl.com/chairman.php" target="_blank" rel="noreferrer">Read our chairman’s message <span aria-hidden="true">↗</span></a></div></div><figure class="story-image"><img src="/images/beamco/webimg/chairman.jpg" alt="K. K. Peethambaran, Chairman and Managing Director" /><figcaption>K. K. Peethambaran<br />Chairman &amp; Managing Director</figcaption></figure></div>
			</section>

			<section class="values-section"><div class="wrap values-layout"><div class="values-title"><h2>How we work<br />with clients.</h2><p>We combine specialist knowledge with the coordination needed for complex projects and occupied properties.</p></div><div class="values-list">{values.map((value) => <article class="value-row"><span>{value.n}</span><div><h3>{value.title}</h3><p>{value.text}</p></div><span class="value-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>

			<section class="project-section" id="projects"><img class="project-photo" src="/images/beamco/webimg/projects-list-beamelectro01.jpg" alt="Mechanical engineering installation" /><div class="project-graphic" aria-hidden="true"><div class="project-ring ring-a"></div><div class="project-ring ring-b"></div><div class="project-block"></div><div class="project-dot"></div></div><div class="wrap project-content"><h2>Services for projects<br />and properties.</h2><p>We support commercial, residential, hospitality and institutional environments with complementary services from construction delivery through to ongoing operations.</p><a class="button button-light" href="#contact">Discuss your requirements <span aria-hidden="true">↗</span></a></div></section>

			<section class="contact-section" id="contact"><div class="wrap contact-layout"><div><h2>Contact us.</h2></div><div class="contact-details"><p>For business enquiries, project requirements or an introduction to the relevant company, contact our Dubai office.</p><a class="contact-email" href="mailto:beamco@beamcointl.com">beamco@beamcointl.com <span aria-hidden="true">↗</span></a><div class="contact-meta"><span>Call us</span><a href="tel:+97144226185">+971 4 422 6185</a><span>Office</span><p>XL Tower, Business Bay<br />Dubai, United Arab Emirates</p></div></div></div></section>
		</main>
		<footer class="site-footer"><div class="wrap footer-main"><a class="brand brand-footer" href="#top"><img class="brand-logo" src="/images/brand/kkp-group-logo.png" alt="KKP Group" /></a><p>Engineering, construction<br />and property services.</p><div class="footer-links"><a href="#about">Our history</a><a href="#companies">Our companies</a><a href="#projects">Our services</a><a href="mailto:beamco@beamcointl.com">Email us ↗</a></div></div><div class="wrap footer-bottom"><span>© 2026 KKP Group · Prototype concept</span><span>Formerly Beamco Group · Details subject to client confirmation</span></div></footer>
	</div>

	<aside class="design-switcher" aria-label="Prototype design options">
		<button class="switcher-trigger" type="button" aria-expanded="false" aria-controls="switcher-panel"><span class="switcher-icon" aria-hidden="true">◐</span><span>Explore designs</span><span class="switcher-chevron" aria-hidden="true">⌃</span></button>
		<div class="switcher-panel" id="switcher-panel" hidden><p class="switcher-kicker">KKP GROUP · CONCEPTS</p><p class="switcher-title">Choose a direction</p><div class="design-options" role="group" aria-label="Choose a design"><button class="design-option" type="button" data-choice="modern" aria-pressed="true"><span class="option-swatch swatch-modern"></span><span><b>01 — Modern</b><small>Warm, confident, contemporary</small></span><span class="option-check">✓</span></button><button class="design-option" type="button" data-choice="heritage" aria-pressed="false"><span class="option-swatch swatch-heritage"></span><span><b>02 — Heritage</b><small>Classic corporate, established</small></span><span class="option-check">✓</span></button><button class="design-option" type="button" data-choice="editorial" aria-pressed="false"><span class="option-swatch swatch-editorial"></span><span><b>03 — Editorial</b><small>Bold, expressive, distinctive</small></span><span class="option-check">✓</span></button></div><p class="switcher-hint">This prototype switcher is visible for review only.</p></div>
	</aside>

	<script>
		const shell = document.querySelector('.site-shell');
		const trigger = document.querySelector('.switcher-trigger');
		const panel = document.querySelector('.switcher-panel');
		const choices = [...document.querySelectorAll('.design-option')];
		const menuToggle = document.querySelector('.menu-toggle');
		const nav = document.querySelector('.main-nav');

		const setDesign = (design) => {
			if (!['modern', 'heritage', 'editorial'].includes(design)) return;
			shell?.setAttribute('data-design', design);
			choices.forEach((choice) => choice.setAttribute('aria-pressed', String(choice.dataset.choice === design)));
			try { localStorage.setItem('kkp-design', design); } catch {}
		};

		try {
			const savedDesign = localStorage.getItem('kkp-design');
			if (savedDesign) setDesign(savedDesign);
		} catch {}

		trigger?.addEventListener('click', () => {
			const open = trigger.getAttribute('aria-expanded') !== 'true';
			trigger.setAttribute('aria-expanded', String(open));
			if (panel) panel.hidden = !open;
		});
		choices.forEach((choice) => choice.addEventListener('click', () => setDesign(choice.dataset.choice ?? 'modern')));
		menuToggle?.addEventListener('click', () => {
			const open = menuToggle.getAttribute('aria-expanded') !== 'true';
			menuToggle.setAttribute('aria-expanded', String(open));
			nav?.classList.toggle('is-open', open);
		});
		nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
			nav.classList.remove('is-open');
			menuToggle?.setAttribute('aria-expanded', 'false');
		}));
	</script>
</Layout>

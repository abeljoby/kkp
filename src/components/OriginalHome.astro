---
import LinkArrow from './LinkArrow.astro';
// Preserved from 9a84895, before the requirement-led content rewrite.
import { values, chairmanMessage } from "../data/group";
import { directory } from "../data/homepage";
import ServiceStrip from "./ServiceStrip.astro";
import ServiceHeading from "./ServiceHeading.astro";
import HeroSlideshow from "./HeroSlideshow.astro";
import CompanyCard from "./CompanyCard.astro";
const asset = (path: string) => `${import.meta.env.BASE_URL}/${path.replace(/^\//, '')}`;
---
  <div class="site-shell previous-shell" data-design="signature">
    <a class="skip-link" href="#previous-main-content">Skip to content</a>
    <div class="utility-bar"><div class="wrap utility-inner"><span>Expertise for every stage</span><div class="utility-links"><a href="tel:+97144226185">+971 4 422 6185</a><a href="mailto:beamco@beamcointl.com">beamco@beamcointl.com</a></div></div></div>
    <header class="site-header" id="previous-top"><div class="wrap header-inner">
      <a class="brand" href="#previous-top" aria-label="KKP Group home"><img class="brand-logo" src={asset('/images/brand/kkp-group-logo.png')} width="76" height="76" alt="KKP Group" /><span class="brand-wordmark" aria-hidden="true">KKP GROUP<small>Since 1980</small></span></a>
      <nav class="main-nav" id="previous-main-navigation" aria-label="Main navigation"><a href="#previous-about">Our story</a><a href="#previous-companies">Our expertise</a><a href="#previous-projects">Our work</a><a href="#previous-contact">Contact</a></nav>
      <a class="header-cta" href="#previous-contact">Get in touch</a>
      <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="previous-main-navigation"><span></span><span></span></button>
    </div></header>
    <main id="previous-main-content">
      <section class="hero" aria-labelledby="previous-hero-title">
        <HeroSlideshow class="hero-media" />
        <div class="wrap hero-content">
          <h1 id="previous-hero-title">Engineering, <br />construction and <br /><span>property services.</span></h1>
          <p class="hero-copy">We provide specialist engineering, construction, interior, facilities management and business services.</p>
          <div class="hero-actions"><a class="button button-primary" href="#previous-companies">Our expertise</a><a class="text-link" href="#previous-about">Our history</a></div>
        </div>
        <ServiceHeading prefix="previous-company-" />
      </section>
      <ServiceStrip prefix="previous-company-" />

      <section class="companies-section section" id="previous-companies"><div class="wrap">
        <div class="section-heading"><h2>Our expertise <br /><span>and services.</span></h2><p>We bring together MEP contracting, construction, joinery, interior fit-out, facilities management and business-centre services.</p></div>
        <div class="company-grid">{directory.map((company) => <CompanyCard company={company} prefix="previous-company-" />)}</div>

      </div></section>

      <section class="story-section section" id="previous-about"><div class="wrap story-layout">
        <div class="story-main"><h2>{chairmanMessage.title}</h2><div class="story-copy">{chairmanMessage.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div>
        <figure class="story-image"><img src={asset('/images/beamco/webimg/chairman.jpg')} alt="K. K. Peethambaran, Chairman and Managing Director, at his office" width="767" height="511" loading="lazy" /><figcaption><strong>K. K. Peethambaran</strong><span>Chairman &amp; Managing Director</span></figcaption></figure>
        <div class="story-date"><span class="story-origin-label">Built on experience</span><strong>Since 1980</strong><p>Decades of experience in construction and maintenance.</p></div>
      </div></section>

      <section class="values-section section"><div class="wrap values-layout"><div class="values-title"><h2>How we work <br /><span>with clients.</span></h2><p>We combine specialist knowledge with the coordination needed for complex projects and occupied properties.</p></div><div class="values-list">{values.map((value) => <article class="value-row"><span class="value-number">{value.n}</span><div><h3>{value.title}</h3><p>{value.text}</p></div></article>)}</div></div></section>

      <section class="project-section" id="previous-projects"><div class="wrap project-layout"><div class="project-content"><h2>Services for projects <br />and properties.</h2><p>We support commercial, residential, hospitality and institutional environments with complementary services from construction delivery through to ongoing operations.</p><a class="button button-light" href="#previous-contact">Discuss your requirements <LinkArrow /></a></div><div class="project-visual"><figure><img class="project-photo" src={asset('/images/beamco/webimg/projects-list-beamelectro01.jpg')} alt="Mechanical engineering installation" width="360" height="276" loading="lazy" /><figcaption>Beam Electro-Mechanical</figcaption></figure><ul class="sector-list" aria-label="Environments we support"><li>Commercial</li><li>Residential</li><li>Hospitality</li><li>Institutional</li></ul></div></div></section>

      <section class="contact-section section" id="previous-contact"><div class="wrap contact-layout"><div><h2>Contact us.</h2><p>For business enquiries or to discuss your project requirements, contact our team.</p></div><div class="contact-details"><a class="contact-email" href="mailto:beamco@beamcointl.com">beamco@beamcointl.com</a><div class="contact-meta"><div><span>Call us</span><a href="tel:+97144226185">+971 4 422 6185</a></div><div><span>Office</span><p>XL Tower, Business Bay <br />Dubai, United Arab Emirates</p></div></div></div></div></section>
    </main>
    <footer class="site-footer"><div class="wrap footer-main"><a class="brand" href="#previous-top" aria-label="KKP Group home"><img class="brand-logo" src={asset('/images/brand/kkp-group-logo.png')} width="76" height="76" loading="lazy" alt="KKP Group" /><span class="brand-wordmark" aria-hidden="true">KKP GROUP<small>Since 1980</small></span></a><p>Engineering, construction <br />and property services.</p><div class="footer-links"><a href="#previous-about">Our history</a><a href="#previous-companies">Our expertise</a><a href="#previous-projects">Our work</a><a href="#previous-contact">Contact us</a></div></div><div class="wrap footer-bottom"><span>© 2026 KKP Group</span></div></footer>
  </div>

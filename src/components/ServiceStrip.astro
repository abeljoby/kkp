---
import LinkArrow from './LinkArrow.astro';
import { services } from '../data/services';
interface Props { prefix?: string }
const { prefix = '' } = Astro.props;
---
<section class="service-strip" aria-labelledby={`${prefix}service-heading`} data-service-strip>
  <div class="service-viewport">
    <div class="service-track">
      {[false, true].map((duplicate) => <ul class="service-group" aria-hidden={duplicate ? 'true' : undefined}>
        {services.map((service) => <li><a href={`#${prefix}${service.companyId}`} data-service-link tabindex={duplicate ? -1 : undefined}>
          <span class="service-name">{service.title}</span>
          <LinkArrow class="service-arrow" />
        </a></li>)}
      </ul>)}
    </div>
  </div>
</section>

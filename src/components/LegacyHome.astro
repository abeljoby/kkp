---
import { companies, values } from "../data/group";
const asset = (path: string) => `${import.meta.env.BASE_URL}/${path.replace(/^\//, '')}`;
---
<div class="legacy-shell" hidden>
	<div class="site-shell hybrid-shell" data-design="modern">
		<div class="utility-bar">
			<div class="wrap utility-inner">
				<span>Dubai, United Arab Emirates</span>
				<div class="utility-links"><a href="tel:+97144226185">+971 4 422 6185</a><span class="utility-divider"></span><a href="mailto:beamco@beamcointl.com">Email the group <span aria-hidden="true">↗</span></a></div>
			</div>
		</div>
		<header class="site-header wrap">
			<a class="brand" href="#legacy-top" aria-label="KKP Group home"><img class="brand-logo" src={asset('/images/brand/kkp-group-logo.png')} alt="KKP Group" /></a>
			<nav id="legacy-navigation" class="main-nav" aria-label="Main navigation">
				<a href="#legacy-about">Our story</a><a href="#legacy-companies">Our companies</a><a href="#legacy-projects">Our work</a><a href="#legacy-contact">Contact</a>
			</nav>
			<a class="header-cta" href="#legacy-companies">Explore the group <span aria-hidden="true">↗</span></a>
			<button class="menu-toggle" type="button" aria-controls="legacy-navigation" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>
		</header>

		<main id="legacy-top">
			<section class="hero">
				<img class="hybrid-hero-photo" src={asset('/images/beamco/webimg/hbanner01.jpg')} alt="Building services across a Dubai rooftop, with the city skyline beyond" width="1920" height="700" fetchpriority="high" />
				<div class="wrap hero-content">
					<h1>Engineering, construction<br />and property services<span class="hero-period">.</span></h1>
					<p class="hero-copy">We provide specialist engineering, construction, interior, facilities management and business services across the UAE. Our operating history began in Dubai in 1980 as Beamco Group.</p>
					<div class="hero-actions"><a class="button button-primary" href="#legacy-companies">Our companies <span aria-hidden="true">↗</span></a><a class="text-link" href="#legacy-about">Our history <span aria-hidden="true">↓</span></a></div>
				</div>
			</section>

			<section class="proof-strip" aria-label="Group highlights"><div class="wrap proof-inner"><span class="proof-label">KKP Group<br />formerly Beamco Group</span><div class="proof-item"><strong>1980</strong><span>Established in Dubai</span></div><div class="proof-item"><strong>06</strong><span>Specialist companies</span></div><div class="proof-item"><strong>UAE</strong><span>Serving the UAE market</span></div><a class="proof-link" href="#legacy-about" aria-label="Learn about our history">↘</a></div></section>

			<section class="section companies-section" id="legacy-companies">
				<div class="wrap">
					<div class="section-heading"><div><h2>Our companies<br />and capabilities.</h2></div><p class="section-intro">We bring together MEP contracting, construction, joinery, interior fit-out, facilities management and business-centre services.</p></div>
					<div class="company-grid">
						{companies.map((company) => <a class="company-card" href="#legacy-contact"><div class="hybrid-company-image"><img class="company-cover" src={asset(company.image)} alt="" width="1920" height="552" loading="lazy" /><span class="company-number">{company.number}</span></div><div class="hybrid-company-copy"><span class="company-name">{company.name}</span><span class="company-type">{company.type}</span><span class="company-arrow" aria-hidden="true">↗</span></div></a>)}
					</div>
					<p class="content-note"><sup>1</sup> KKP Group is the successor identity to Beamco Group. Company names, service descriptions and contact details remain subject to client confirmation.</p>
				</div>
			</section>

			<section class="story-section" id="legacy-about">
				<div class="wrap story-layout"><div class="story-label"><span class="story-index">Since<br /><b>1980</b></span></div><div class="story-main"><h2>Our roots are in Dubai’s<br />construction sector.</h2><div class="story-copy"><p>We began in 1980 as Beamco Group, working in the UAE construction and maintenance sector. Over time, we have added specialist businesses that support the planning, delivery and operation of properties.</p><p>Today, our companies work across MEP engineering, construction, interior fit-out, joinery, facilities services and business space—each with a clear area of responsibility.</p><a class="text-link" href="https://beamcointl.com/chairman.php" target="_blank" rel="noreferrer">Read our chairman’s message <span aria-hidden="true">↗</span></a></div></div><figure class="story-image"><img src={asset('/images/beamco/webimg/chairman.jpg')} alt="K. K. Peethambaran, Chairman and Managing Director" /><figcaption>K. K. Peethambaran<br />Chairman &amp; Managing Director</figcaption></figure></div>
			</section>

			<section class="values-section"><div class="wrap values-layout"><div class="values-title"><h2>How we work<br />with clients.</h2><p>We combine specialist knowledge with the coordination needed for complex projects and occupied properties.</p></div><div class="values-list">{values.map((value) => <article class="value-row"><span>{value.n}</span><div><h3>{value.title}</h3><p>{value.text}</p></div><span class="value-arrow" aria-hidden="true">↗</span></article>)}</div></div></section>

			<section class="project-section" id="legacy-projects"><img class="project-photo" src={asset('/images/beamco/webimg/projects-list-beamelectro01.jpg')} alt="Mechanical engineering installation" /><div class="project-graphic" aria-hidden="true"><div class="project-ring ring-a"></div><div class="project-ring ring-b"></div><div class="project-block"></div><div class="project-dot"></div></div><div class="wrap project-content"><h2>Services for projects<br />and properties.</h2><p>We support commercial, residential, hospitality and institutional environments with complementary services from construction delivery through to ongoing operations.</p><a class="button button-light" href="#legacy-contact">Discuss your requirements <span aria-hidden="true">↗</span></a></div></section>

			<section class="contact-section" id="legacy-contact"><div class="wrap contact-layout"><div><h2>Contact us.</h2></div><div class="contact-details"><p>For business enquiries, project requirements or an introduction to the relevant company, contact our Dubai office.</p><a class="contact-email" href="mailto:beamco@beamcointl.com">beamco@beamcointl.com <span aria-hidden="true">↗</span></a><div class="contact-meta"><span>Call us</span><a href="tel:+97144226185">+971 4 422 6185</a><span>Office</span><p>XL Tower, Business Bay<br />Dubai, United Arab Emirates</p></div></div></div></section>
		</main>
		<footer class="site-footer"><div class="wrap footer-main"><a class="brand brand-footer" href="#legacy-top"><img class="brand-logo" src={asset('/images/brand/kkp-group-logo.png')} alt="KKP Group" /></a><p>Engineering, construction<br />and property services.</p><div class="footer-links"><a href="#legacy-about">Our history</a><a href="#legacy-companies">Our companies</a><a href="#legacy-projects">Our services</a><a href="mailto:beamco@beamcointl.com">Email us ↗</a></div></div><div class="wrap footer-bottom"><span>© 2026 KKP Group · Prototype concept</span><span>Formerly Beamco Group · Details subject to client confirmation</span></div></footer>
	</div>

</div>

---
import LinkArrow from './LinkArrow.astro';
import { values, chairmanMessage } from "../data/group";
import { directory } from "../data/homepage";
import ServiceStrip from "./ServiceStrip.astro";
import ServiceHeading from "./ServiceHeading.astro";
import HeroSlideshow from "./HeroSlideshow.astro";
import CompanyCard from "./CompanyCard.astro";
import EnvironmentCarousel from "./EnvironmentCarousel.astro";
const asset = (path: string) => `${import.meta.env.BASE_URL}/${path.replace(/^\//, '')}`;
---
<div class="legacy-shell" hidden>
	<div class="site-shell hybrid-shell" data-design="modern">
		<div class="utility-bar">
			<div class="wrap utility-inner">
				<span>Expertise for every stage</span>
				<div class="utility-links"><a href="tel:+97144226185">+971 4 422 6185</a><span class="utility-divider"></span><a href="mailto:beamco@beamcointl.com">Email the group</a></div>
			</div>
		</div>
		<header class="site-header wrap">
			<a class="brand" href="#legacy-top" aria-label="KKP Group home"><img class="brand-logo" src={asset('/images/brand/kkp-group-logo.png')} alt="KKP Group" /></a>
			<nav id="legacy-navigation" class="main-nav" aria-label="Main navigation">
				<a href="#legacy-about">Our story</a><a href="#legacy-companies">Our expertise</a><a href="#legacy-projects">Our work</a><a href="#legacy-contact">Contact</a>
			</nav>
			<a class="header-cta" href="#legacy-companies">Explore our expertise</a>
			<button class="menu-toggle" type="button" aria-controls="legacy-navigation" aria-label="Open navigation" aria-expanded="false"><span></span><span></span></button>
		</header>

		<main id="legacy-top">
			<section class="hero">
				<HeroSlideshow class="hybrid-hero-slideshow" imageClass="hybrid-hero-photo" />
				<div class="wrap hero-content">
					<h1>Engineering, construction<br />and property services<span class="hero-period">.</span></h1>
					<p class="hero-copy">We provide specialist engineering, construction, interior, facilities management and business services.</p>
					<div class="hero-actions"><a class="button button-primary" href="#legacy-companies">Our expertise</a><a class="text-link" href="#legacy-about">Our history</a></div>
				</div>
				<ServiceHeading prefix="legacy-company-" />
			</section>

			<ServiceStrip prefix="legacy-company-" />

			<section class="section companies-section" id="legacy-companies">
				<div class="wrap">
					<div class="section-heading"><div><h2>Our expertise<br />and services.</h2></div><p class="section-intro">We bring together MEP contracting, construction, joinery, interior fit-out, facilities management and business-centre services.</p></div>
					<div class="company-grid">
						{directory.map((company) => <CompanyCard company={company} prefix="legacy-company-" />)}
					</div>

				</div>
			</section>

			<section class="story-section" id="legacy-about">
				<div class="wrap story-layout"><div class="story-label"><span class="story-index">Since<br /><b>1980</b></span></div><div class="story-main"><h2>{chairmanMessage.title}</h2><div class="story-copy">{chairmanMessage.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div></div><figure class="story-image"><img src={asset('/images/beamco/webimg/chairman.jpg')} alt="K. K. Peethambaran, Chairman and Managing Director" /><figcaption>K. K. Peethambaran<br />Chairman &amp; Managing Director</figcaption></figure></div>
			</section>

			<section class="values-section"><div class="wrap values-layout"><div class="values-title"><h2>How we work<br />with clients.</h2><p>We combine specialist knowledge with the coordination needed for complex projects and occupied properties.</p></div><div class="values-list">{values.map((value) => <article class="value-row"><span>{value.n}</span><div><h3>{value.title}</h3><p>{value.text}</p></div></article>)}</div></div></section>

			<section class="project-section environment-section" id="legacy-projects"><div class="wrap project-layout"><div class="project-content"><h2>Services for projects<br />and properties.</h2><p>We support commercial, residential, hospitality and institutional environments with complementary services from construction delivery through to ongoing operations.</p><a class="button button-light" href="#legacy-contact">Discuss your requirements <LinkArrow /></a></div><div class="project-visual"><EnvironmentCarousel prefix="legacy" /></div></div></section>

			<section class="contact-section" id="legacy-contact"><div class="wrap contact-layout"><div><h2>Contact us.</h2></div><div class="contact-details"><p>For business enquiries or to discuss your project requirements, contact our team.</p><a class="contact-email" href="mailto:beamco@beamcointl.com">beamco@beamcointl.com</a><div class="contact-meta"><span>Call us</span><a href="tel:+97144226185">+971 4 422 6185</a><span>Office</span><p>XL Tower, Business Bay<br />Dubai, United Arab Emirates</p></div></div></div></section>
		</main>
		<footer class="site-footer"><div class="wrap footer-main"><a class="brand brand-footer" href="#legacy-top"><img class="brand-logo" src={asset('/images/brand/kkp-group-logo.png')} alt="KKP Group" /></a><p>Engineering, construction<br />and property services.</p><div class="footer-links"><a href="#legacy-about">Our history</a><a href="#legacy-companies">Our expertise</a><a href="#legacy-projects">Our services</a><a href="mailto:beamco@beamcointl.com">Email us</a></div></div><div class="wrap footer-bottom"><span>© 2026 KKP Group</span></div></footer>
	</div>

</div>

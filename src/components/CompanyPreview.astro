---
import { directory } from '../data/homepage';
import { services } from '../data/services';
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}/${path.replace(/^\//, '')}`;
---
<dialog class="company-preview" aria-labelledby="company-preview-title">
  <button class="preview-close" type="button" aria-label="Close company preview" autofocus>×</button>
  <div class="preview-content"></div>
</dialog>
{directory.map((company) => <template data-company-preview={company.id}>
  <img class="preview-image" src={asset(company.image)} alt="" width="1920" height="552" />
  <div class="preview-copy">
    <p class="preview-discipline">{company.discipline}</p>
    <h2 id="company-preview-title">{company.name}</h2>
    <p>{company.description}</p>
    <ul aria-label="Company services">{services.filter((service) => service.companyId === company.id).map((service) => <li>{service.title}</li>)}</ul>
    <a class="preview-enquiry" href={`mailto:beamco@beamcointl.com?subject=${encodeURIComponent(`Enquiry: ${company.name}`)}`}>{company.enquiry}<span aria-hidden="true">↗</span></a>
  </div>
</template>)}
<script>
  import '../scripts/company-interactions';
</script>
